# /app is the SPA shell; serve it without a redirect hop.
/app        /app.html   200
/app/       /app.html   200

# Old single-file hash routes now have real static pages. These catch anyone
# who bookmarked the .html entry; the SPA router also forwards #/hash at runtime.
/index.html            /            301
/aromas.html           /aromas/     301

# Older copies of NOSE linked the legal pages under /legal/. There is one page
# each, at /privacy/ and /terms/; these send those links there rather than
# keeping a second copy that could say something different.
/legal/privacy         /privacy/    301
/legal/privacy/        /privacy/    301
/legal/terms           /terms/      301
/legal/terms/          /terms/      301

# Fingerprinted bundle: keep the unhashed path working if anything references it.
/js/nose.js  /js/nose.705c9bba.js  302

# Netlify serves /404.html automatically for unmatched paths.

# Source, not website. The runtime path /.netlify/* is unaffected.
#
# Every rule below needs its "!". Without it Netlify serves any file that
# exists and applies the rule only to paths that do not - so, unforced, these
# rules did nothing for the very files they were written to hide.
# scripts/check-published.js counts only forced rules as blocking, so deleting
# a "!" puts that path straight back under its scan.
/netlify/*           /404.html   404!
/node_modules/*      /404.html   404!
/docs/*              /404.html   404!
/test/*              /404.html   404!
/scripts/*           /404.html   404!
/supabase/*          /404.html   404!
/wip/*               /404.html   404!
/build.sh            /404.html   404!
/setup.sh            /404.html   404!
/verify-manifest.sh  /404.html   404!
/dump-ordering.js    /404.html   404!
/package.json        /404.html   404!
/package-lock.json   /404.html   404!
/PARSER-HANDOFF.md   /404.html   404!
/.env                /404.html   404!
